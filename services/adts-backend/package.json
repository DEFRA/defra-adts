{
  "name": "adts-submissions-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/client/all.js --bundle --minify --outfile=src/public/js/all.js",
    "start": "node src/index.js",
    "test": "npm run test:routes",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit tests/component tests/routes --coverage",
    "test:integration": "../../local/dynamodb/test-db.sh up && ../../local/dynamodb/test-db.sh reset && node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "start:watch": "nodemon --ext njk --signal SIGTERM src/app.js",
    "kill": "sh -c 'pids=$(lsof -tiTCP:9182 -sTCP:LISTEN); [ -z \"$pids\" ] || kill $pids'",
    "lint": "eslint .",
    "test:routes": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/routes --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1158.0",
    "@aws-sdk/lib-dynamodb": "3.1158.0",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "joi": "^18.2.9"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "jest": "^30.5.2",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14"
  }
}
