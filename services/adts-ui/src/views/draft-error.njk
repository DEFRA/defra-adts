{% extends "govuk/template.njk" %}

{% from "macros/serviceHeader.njk" import appServiceHeader %}

{% block pageTitle %}Unable to continue draft – ADTS{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/application.css">
{% endblock %}

{% block header %}
  {{ appServiceHeader() }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Unable to continue draft</h1>
      <p class="govuk-body">{{ message }}</p>
      <a class="govuk-link" href="/">Return to your submissions</a>
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/js/all.js"></script>
{% endblock %}
