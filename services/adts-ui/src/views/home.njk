{% extends "govuk/template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% block pageTitle %}Home – ADTS{% endblock %}

{% block header %}
  {{ govukHeader({
    serviceName: "Animal Disease Testing Service",
    serviceUrl: "/",
    navigation: [
      {
        text: "My Account",
        href: "/",
        active: true
      },
      {
        text: "Sign out",
        href: "/",
        active: true
      }
    ]
  }) }}
{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/application.css">
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body">Signed in as Test User 2</p>
      <h1 class="govuk-heading-l">New submission</h1>
      <p class="govuk-body">Start a new sick animal submission or healthy animal submission.</p>
      {{ govukButton({
        text: "Sick animal submission",
        href: "#",
        isStartButton: true
      }) }}
      {{ govukButton({
        text: "Healthy animal submission",
        href: "#",
        isStartButton: true
      }) }}

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <h2 class="govuk-heading-l">View completed submissions or edit draft submissions</h2>
      <form id="home-filter-form" method="get" action="/">
        <h3 class="govuk-heading-m">Filter submissions by</h3>
        <div class="govuk-grid-row app-submission-filters">
          <div class="govuk-grid-column-one-quarter">
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{ govukInput({
              id: "client",
              name: "client",
              label: {
                text: "Client"
              },
              attributes: {
                maxlength: 200
              },
              value: query.client
            }) }}
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{ govukInput({
              id: "clinician",
              name: "clinician",
              label: {
                text: "Clinician"
              },
              attributes: {
                maxlength: 200
              },
              value: query.clinician
            }) }}
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{ govukSelect({
              id: "status",
              name: "status",
              label: {
                text: "Status"
              },
              items: [
                {
                  value: "show all",
                  text: "Show All"
                },
                {
                  value: "draft",
                  text: "Draft",
                  selected: query.status == "draft"
                },
                {
                  value: "submitted",
                  text: "Submitted",
                  selected: query.status == "submitted"
                },
                {
                  value: "in_progress",
                  text: "In Progress",
                  selected: query.status == "in_progress"
                },
                {
                  value: "completed",
                  text: "Completed",
                  selected: query.status == "completed"
                },
                {
                  value: "samples_overdue",
                  text: "Samples Overdue",
                  selected: query.status == "samples_overdue"
                },
                {
                  value: "tests_complete",
                  text: "All Tests Complete",
                  selected: query.status == "tests_complete"
                },
                {
                  value: "available",
                  text: "Results Available",
                  selected: query.status == "available"
                }
              ]
            }) }}
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{govukSelect({
              id: "submitted_date",
              name: "submitted_date",
              label: {
                text: "Submitted Date"
              },
              items: [
                {
                  value: "18_months",
                  text: "In the last 18 months",
                  selected: query.submitted_date == "18_months"
                }
              ]
            })}}
          </div>
        </div>
        {{ govukButton({
          text: "Search",
          type: "submit"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/js/all.js"></script>
{% endblock %}
