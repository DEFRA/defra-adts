{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "macros/submissionSearchForm.njk" import submissionSearchForm %}

{% block pageTitle %}Home – ADTS{% endblock %}

{% block header %}
  {{ govukHeader({
    serviceName: "Animal Disease Testing Service",
    serviceUrl: "/",
    navigation: [
      {
        text: "My Account",
        href: "/",
        active: true
      },
      {
        text: "Sign out",
        href: "/",
        active: true
      }
    ]
  }) }}
{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/application.css">
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p class="govuk-body">Signed in as Test User 2</p>
      <h1 class="govuk-heading-l">New submission</h1>
      <p class="govuk-body">Start a new sick animal submission or healthy animal submission.</p>
      <ul class="govuk-list govuk-!-margin-bottom-8">
        <li><a class="govuk-link govuk-!-font-size-24" href="/submission-01-client-details">Sick animal submission</a></li>
        <li><a class="govuk-link govuk-!-font-size-24" href="/submission-01-client-details">Healthy animal submission</a></li>
      </ul>

      <h2 class="govuk-heading-l">Clients</h2>
      <ul class="govuk-list govuk-!-margin-bottom-8">
        <li><a class="govuk-link govuk-!-font-size-24" href="/create-client">Create a new client</a></li>
        <li><a class="govuk-link govuk-!-font-size-24" href="/update-client">Update an existing client's details</a></li>
      </ul>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <h2 class="govuk-heading-l">View completed submissions or edit draft submissions</h2>
      {{ submissionSearchForm(filteredValues, "Search") }}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/js/all.js"></script>
{% endblock %}
