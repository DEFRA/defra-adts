{% extends "govuk/template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/submissionSearchForm.njk" import submissionSearchForm %}
{% from "macros/serviceHeader.njk" import appServiceHeader %}

{% block pageTitle %}Home – ADTS{% endblock %}

{% block header %}
  {{ appServiceHeader() }}
{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/application.css">
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if account %}
        <p class="govuk-body">Signed in as {{ account.name }}</p>
      {% endif %}
      <h2 class="govuk-heading-m">New submission</h2>
      <p class="govuk-body">Start a new sick animal submission or healthy animal submission.</p>
      <div class="app-button-stack">
        {{ govukButton({
          text: "Sick animal submission",
          href: "/submission-01-client-details/start?type=sick",
          classes: "app-button--sick",
          isStartButton: true
        }) }}
        {{ govukButton({
          text: "Healthy animal submission",
          href: "/submission-01-client-details/start?type=healthy",
          classes: "app-button--healthy",
          isStartButton: true
        }) }}
      </div>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <h2 class="govuk-heading-l">View completed submissions or edit draft submissions</h2>
      {{ submissionSearchForm(filteredValues, "Search") }}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/js/all.js"></script>
{% endblock %}
