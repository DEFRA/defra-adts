{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% macro submissionSearchForm(filteredValues, buttonText) %}
  <form method="get" action="/results">
    <h3 class="govuk-heading-m">Filter submissions by</h3>
    <div class="govuk-grid-row app-submission-filters">
      <div class="govuk-grid-column-one-quarter">
        {{ govukInput({
          id: "client",
          name: "client",
          value: filteredValues.client,
          label: { text: "Client" }
        }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {{ govukInput({
          id: "clinician",
          name: "clinician",
          value: filteredValues.clinician,
          label: { text: "Clinician" }
        }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {{ govukSelect({
          id: "status",
          name: "status",
          label: { text: "Status" },
          items: [
            { value: "show_all", text: "Show all", selected: filteredValues.status == 'show_all' },
            { value: "draft", text: "Draft", selected: filteredValues.status == 'draft' },
            { value: "submitted", text: "Submitted", selected: filteredValues.status == 'submitted' },
            { value: "in_progress", text: "In progress", selected: filteredValues.status == 'in_progress' },
            { value: "cancelled", text: "Cancelled", selected: filteredValues.status == 'cancelled' },
            { value: "samples_overdue", text: "Samples overdue", selected: filteredValues.status == 'samples_overdue' },
            { value: "tests_complete", text: "All tests complete", selected: filteredValues.status == 'tests_complete' }
          ]
        }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {{ govukSelect({
          id: "submitted-date",
          name: "submitted-date",
          label: { text: "Submitted date" },
          items: [
            { value: "1_day", text: "In the last day", selected: filteredValues.submitted_date == '1_day' },
            { value: "1_week", text: "In the last week", selected: filteredValues.submitted_date == '1_week' },
            { value: "14_days", text: "In the last 14 days", selected: filteredValues.submitted_date == '14_days' },
            { value: "1_month", text: "In the last month", selected: filteredValues.submitted_date == '1_month' },
            { value: "6_months", text: "In the last 6 months", selected: filteredValues.submitted_date == '6_months' },
            { value: "1_year", text: "In the last year", selected: filteredValues.submitted_date == '1_year' },
            { value: "18_months", text: "In the last 18 months", selected: filteredValues.submitted_date == '18_months' or not filteredValues.submitted_date }
          ]
        }) }}
      </div>
    </div>
    {{ govukButton({
      text: buttonText,
      type: "submit"
    }) }}
  </form>
{% endmacro %}
