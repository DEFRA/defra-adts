{% extends "govuk/template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% block pageTitle %}Search Results – ADTS{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/application.css">
{% endblock %}

{% block header %}
  {{ govukHeader({
    serviceName: "Animal Disease Testing Service",
    serviceUrl: "/",
    navigation: [
      { text: "My Account", href: "/" },
      { text: "Sign out", href: "/" }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      
      <a href="/" class="govuk-back-link">Back to home dashboard</a>

      <h1 class="govuk-heading-l govuk-!-margin-top-4">Submission search results</h1>

      <!-- Filter Form UI -->
      <form method="get" action="/results">
        <h3 class="govuk-heading-m">Filter submissions by</h3>
        <div class="govuk-grid-row app-submission-filters">
          <div class="govuk-grid-column-one-quarter">
            {{ govukInput({
              id: "client",
              name: "client",
              value: filteredValues.client,
              label: { text: "Client" }
            }) }}
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{ govukInput({
              id: "clinician",
              name: "clinician",
              value: filteredValues.clinician,
              label: { text: "Clinician" }
            }) }}
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{ govukSelect({
              id: "status",
              name: "status",
              label: { text: "Status" },
              items: [
                { value: "show all", text: "Show all", selected: filteredValues.status == 'show all' },
                { value: "draft", text: "Draft", selected: filteredValues.status == 'draft' },
                { value: "submitted", text: "Submitted", selected: filteredValues.status == 'submitted' },
                { value: "in_progress", text: "In progress", selected: filteredValues.status == 'in_progress' },
                { value: "completed", text: "Completed", selected: filteredValues.status == 'completed' },
                { value: "samples_overdue", text: "Samples overdue", selected: filteredValues.status == 'samples_overdue' },
                { value: "tests_complete", text: "Tests complete", selected: filteredValues.status == 'tests_complete' },
                { value: "available", text: "Available", selected: filteredValues.status == 'available' }
              ]
            }) }}
          </div>
          <div class="govuk-grid-column-one-quarter">
            {{ govukInput({
              id: "submitted-date",
              name: "submitted-date",
              type: "date",
              value: filteredValues.submitted_date,
              label: { text: "Submitted date" }
            }) }}
          </div>
        </div>
        {{ govukButton({
          text: "Search again",
          type: "submit"
        }) }}
      </form>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <!-- Dynamic Cards Container Grid -->
      <div id="submission-results-container" class="govuk-!-margin-top-6">
        <p class="govuk-body govuk-!-font-weight-bold">{{ totalCount }} submissions matching criteria</p>

        {% for submission in results %}
          <div class="app-result-card govuk-!-padding-4 govuk-!-margin-bottom-4">
            
            <!-- 1. Header Flex Row: Handles multiple stacked tags dynamically -->
            <div class="app-result-card__header govuk-!-padding-bottom-2 govuk-!-margin-bottom-3">
              <h3 class="govuk-heading-m govuk-!-margin-bottom-0">
                {% if 'Draft' in submission.statuses %}Draft Id: {% endif %}{{ submission.id }}
              </h3>
              
              <div class="app-result-card__tags">
                {% for tag in submission.statuses %}
                  {% set marginClass = "" if loop.last else "govuk-!-margin-bottom-1" %}

                  {% if tag | lower == 'draft' %}
                    <strong class="govuk-tag govuk-tag--orange {{ marginClass }}">Draft</strong>
                  {% elif tag | lower == 'submitted' %}
                    <strong class="govuk-tag app-tag--submitted {{ marginClass }}">Submitted</strong>
                  {% elif tag | lower == 'samples overdue' %}
                    <strong class="govuk-tag app-tag--overdue {{ marginClass }}">Samples overdue</strong>
                  {% else %}
                    <strong class="govuk-tag govuk-tag--blue {{ marginClass }}">{{ tag }}</strong>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <!-- 2. Main Six-Column Metadata Grid -->
            <div class="govuk-grid-row app-result-card__meta-row govuk-body-s {% if submission.hasTests %}app-result-card__meta-row--has-tests{% endif %} govuk-!-padding-bottom-3">
              <div class="govuk-grid-column-one-sixth govuk-!-padding-right-2">
                <span class="govuk-hint govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Samples to</span>
                <span>{{ submission.samplesTo }}</span>
              </div>
              <div class="govuk-grid-column-one-sixth govuk-!-padding-right-2">
                <span class="govuk-hint govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Client</span>
                <span>{{ submission.client }}</span>
              </div>
              <div class="govuk-grid-column-one-sixth govuk-!-padding-right-2">
                <span class="govuk-hint govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Client farm</span>
                <span>{{ submission.clientFarm }}</span>
              </div>
              <div class="govuk-grid-column-one-sixth govuk-!-padding-right-2">
                <span class="govuk-hint govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Species</span>
                <span>{{ submission.species }}</span>
              </div>
              <div class="govuk-grid-column-one-sixth govuk-!-padding-right-2">
                <span class="govuk-hint govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Clinician</span>
                <span>{{ submission.clinician }}</span>
              </div>
              <div class="govuk-grid-column-one-sixth govuk-!-padding-right-2">
                <span class="govuk-hint govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Order submitted</span>
                <span>{{ submission.orderSubmitted }}</span>
              </div>
            </div>

            <!-- 3. Conditional Content Blocks: Empty notice OR tests grid breakdown -->
            {% if not submission.hasTests %}
              <p class="govuk-body govuk-!-margin-top-4 govuk-!-margin-bottom-0">Submission contains no tests.</p>
            {% else %}
              <div class="govuk-!-margin-top-3 govuk-body-s">
                {% for test in submission.tests %}
                  <div class="govuk-grid-row app-result-card__meta-row govuk-!-padding-top-2 govuk-!-padding-bottom-2">
                    <div class="govuk-grid-column-one-half">
                      <span class="govuk-!-font-weight-bold govuk-!-margin-bottom-1 govuk-!-display-block">Test name</span>
                      <span>{{ test.name }}</span>
                    </div>
                    <div class="govuk-grid-column-one-fifth">
                      <span class="govuk-!-font-weight-bold govuk-!-margin-bottom-1 govuk-!-display-block">Test type</span>
                      <span>{{ test.type }}</span>
                    </div>
                    <div class="govuk-grid-column-one-fifth">
                      <span class="govuk-!-font-weight-bold govuk-!-margin-bottom-1 govuk-!-display-block">Sample type</span>
                      <span>{{ test.sampleType }}</span>
                    </div>
                    <div class="govuk-grid-column-one-tenth">
                      <span class="govuk-!-font-weight-bold govuk-!-margin-bottom-1 govuk-!-display-block">Qty</span>
                      <span>{{ test.qty }}</span>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% else %}
          <p class="govuk-body">No records found matching your query criteria.</p>
        {% endfor %}
      </div>

    </div>
  </div>
{% endblock %}
