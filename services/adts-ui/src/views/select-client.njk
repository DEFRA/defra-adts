{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "macros/submissionProgress.njk" import submissionProgress %}

{% block pageTitle %}{% if selectionError or errorList.length %}Error: {% endif %}Client details – ADTS{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/application.css">
  <link rel="stylesheet" href="/assets/css/accessible-autocomplete.min.css">
{% endblock %}

{% block header %}
  {{ govukHeader({
    serviceName: "Animal Disease Testing Service",
    serviceUrl: "/",
    navigation: [
      { text: "My Account", href: "#" },
      { text: "Sign out", href: "#" }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-phase-banner app-phase-banner govuk-body-l">
    <strong class="govuk-tag govuk-phase-banner__content__tag">BETA</strong>
    <span class="govuk-phase-banner__text">
      This is a new service – your <a class="govuk-link" href="#">feedback</a> will help us to improve it.
    </span>
  </div>

  {{ submissionProgress(1) }}

  {% if errorList.length %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: errorList
    }) }}
  {% elif selectionError %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: [{ text: selectionError, href: "#client" }]
    }) }}
  {% endif %}

  <h1 class="govuk-heading-l">1. Client details</h1>
  <p class="govuk-body-l">Tell us about the owner (your client) of the animal or animals you want to test.</p>

  <hr class="govuk-section-break govuk-section-break--visible app-client-details-divider">

  <form method="post" action="/submission-01-client-details" novalidate>
    <h2 class="govuk-heading-l">Client</h2>
    {% if editMode %}
      <p class="govuk-body-l">Enter the details of your client. If you have the full CPH this can be used to retrieve the client record.</p>
      <input type="hidden" name="clientId" value="{{ clientDetails.clientId or '' }}">
      <input type="hidden" name="manualClientEntry" value="yes">

      {{ govukInput({
        id: "cph",
        name: "cph",
        value: clientDetails.cph,
        label: { text: "CPH number eg 48/234/2348" },
        errorMessage: { text: errors.cph } if errors.cph,
        attributes: { "data-cph-input": "true" },
        classes: "govuk-!-width-one-half"
      }) }}
      {{ govukInput({
        id: "name",
        name: "name",
        value: clientDetails.name,
        label: { text: "Name" },
        classes: "govuk-!-width-one-half"
      }) }}
      {{ govukInput({
        id: "farmName",
        name: "farmName",
        value: clientDetails.farmName,
        label: { text: "Farm name" },
        classes: "govuk-!-width-one-half"
      }) }}
      <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend">Address</legend>
        {{ govukInput({
          id: "addressLine1",
          name: "addressLine1",
          value: clientDetails.addressLine1,
          label: { text: "Address line 1" },
          autocomplete: "address-line1",
          classes: "govuk-!-width-one-half"
        }) }}
        {{ govukInput({
          id: "addressLine2",
          name: "addressLine2",
          value: clientDetails.addressLine2,
          label: { text: "Address line 2" },
          autocomplete: "address-line2",
          classes: "govuk-!-width-one-half"
        }) }}
        {{ govukInput({
          id: "addressLine3",
          name: "addressLine3",
          value: clientDetails.addressLine3,
          label: { text: "Address line 3" },
          autocomplete: "address-line3",
          classes: "govuk-!-width-one-half"
        }) }}
      </fieldset>
      {{ govukSelect({
        id: "county",
        name: "county",
        label: { text: "County" },
        items: countyOptions,
        attributes: { "data-default-value": clientDetails.county },
        classes: "govuk-!-width-one-half"
      }) }}
      {{ govukInput({
        id: "postcode",
        name: "postcode",
        value: clientDetails.postcode,
        label: { text: "Postcode" },
        autocomplete: "postal-code",
        classes: "govuk-!-width-one-half"
      }) }}
      <button class="govuk-button govuk-button--secondary" type="submit" name="intent" value="cancel">Cancel</button>
    {% else %}
      <p class="govuk-body-l">Enter the name of your client, their address, or the County Parish Holding (CPH) eg 48/234/2348:</p>
      {{ govukSelect({
        id: "client",
        name: "clientId",
        label: {
          text: "Client",
          classes: "govuk-visually-hidden"
        },
        attributes: {
          "data-default-value": selectedClientName
        },
        items: clientOptions
      }) }}
      <p class="govuk-body app-create-address-link">Or you can <a class="govuk-link" href="/submission-01-client-address?intent=new" data-create-client-address-link>create a new client</a>.</p>
      {% if hasManualClient %}
        <a class="govuk-button govuk-button--secondary" href="/submission-01-client-address?intent=edit">Edit</a>
      {% endif %}
      <button
        class="govuk-button govuk-button--secondary"
        type="submit"
        name="intent"
        value="edit"
        data-client-edit-button
        {% if not hasSelectedClient %}hidden{% endif %}
      >Edit</button>
    {% endif %}

    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
    <div class="app-animal-address">
      {{ govukRadios({
        name: "animalsAtClientAddress",
        fieldset: { legend: { text: "Are the animals at the client’s address?", classes: "govuk-fieldset__legend--m" } },
        items: [
          { value: "yes", text: "Yes", checked: animalsAtClientAddress == "yes" },
          { value: "no", text: "No", checked: animalsAtClientAddress == "no" }
        ]
      }) }}
      <div id="animal-address-selection" {% if animalsAtClientAddress != "no" %}hidden{% endif %}>
        {{ govukSelect({
          id: "animalAddress",
          name: "animalAddressClientId",
          label: { text: "Animal address", classes: "govuk-visually-hidden" },
          attributes: { "data-default-value": selectedAnimalAddressName },
          items: animalAddressOptions
        }) }}
        <input type="hidden" name="animalAddress" value="{{ animalAddress }}">
        <p class="govuk-body app-create-address-link">Or you can <a class="govuk-link" href="/submission-01-animal-address?intent=new" data-create-animal-address-link>create a new animal's address</a>.</p>
        <button class="govuk-button govuk-button--secondary" type="submit" name="intent" value="editAnimalAddress" data-animal-address-edit-button data-manual-address="{% if hasSavedManualAnimalAddress %}true{% else %}false{% endif %}" {% if not hasSelectedAnimalAddress %}hidden{% endif %}>Edit</button>
      </div>
    </div>
    {{ govukButton({
      text: "Continue"
    }) }}
  </form>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/js/all.js"></script>
{% endblock %}